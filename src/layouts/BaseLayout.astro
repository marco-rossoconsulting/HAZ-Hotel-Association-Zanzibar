---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/lib/site';
import { ARCH_PATH } from '@/lib/arch';
import interLatin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import cormorantLatin from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** JSON-LD objects to add for this page */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Last-updated date (brand: required on regulatory and market pages) */
  type?: 'website' | 'article';
}

const { title, description = site.description50, image = '/og-default.jpg', schema = [], noindex = false, type = 'website' } = Astro.props;
const fullTitle = title === site.name ? `${site.name} (HAZ) · ${site.corporateLine}` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${Astro.site}#organization`,
  name: site.name,
  alternateName: 'HAZ',
  url: Astro.site?.toString(),
  logo: new URL('/brand/HAZ_Logo_Gold_Transparent.png', Astro.site).toString(),
  description: site.description50,
  slogan: site.corporateLine,
  foundingDate: site.founded,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.street}, ${site.address.poBox}`,
    addressLocality: site.address.locality,
    addressCountry: 'TZ',
  },
  areaServed: { '@type': 'Place', name: 'Zanzibar, Tanzania' },
  sameAs: Object.values(site.social).filter(Boolean),
};
const ld = [org, ...schema];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#303234" />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cormorantLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <!-- Arch frame: softly pointed top echoing the Mlango (brand section 13). Images only. -->
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
      <defs>
        <clipPath id="haz-arch" clipPathUnits="objectBoundingBox">
          <path d={ARCH_PATH} />
        </clipPath>
      </defs>
    </svg>

    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      import '@/scripts/motion';
      import '@/scripts/forms';
    </script>
  </body>
</html>
