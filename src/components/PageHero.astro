---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArchEdge from './ArchEdge.astro';

interface Props {
  label?: string;
  title: string;
  lead?: string;
  image?: { src: ImageMetadata; alt: string; credit?: string };
  /** 'arch' (default) frames the hero image with the Mlango arch and its dark edge, as on the homepage */
  frame?: 'arch' | 'plain';
  tone?: 'ivory' | 'white' | 'anthracite' | 'ocean';
  updated?: Date;
}
const { label, title, lead, image, frame = 'arch', tone = 'ivory', updated } = Astro.props;
const dark = tone === 'anthracite' || tone === 'ocean';
---

<section class:list={['page-hero', `tone-${tone}`, { 'on-dark': dark, 'has-image': image }]}>
  <div class="container grid-12 ph-grid">
    <div class="ph-text">
      {label && <p class="label" data-reveal>{label}</p>}
      <h1 class="ph-title" data-reveal style="--i:1">{title}</h1>
      {lead && <p class="lead ph-lead" data-reveal style="--i:2">{lead}</p>}
      {updated && (
        <p class="caption ph-updated" data-reveal style="--i:3">
          Last updated <time datetime={updated.toISOString().slice(0, 10)}>{updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
        </p>
      )}
      <div class="ph-slot" data-reveal style="--i:3"><slot /></div>
    </div>
    {image && (
      <figure class:list={['ph-figure', { 'is-arch': frame === 'arch' }]}>
        <div class:list={['ph-img', { arch: frame === 'arch' }]}>
          <Image src={image.src} alt={image.alt} widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 40vw, 92vw" loading="eager" fetchpriority="high" />
          {frame === 'arch' && <ArchEdge />}
        </div>
      </figure>
    )}
  </div>
</section>

<style>
  .page-hero { padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(3rem, 2rem + 3vw, 5rem); position: relative; }
  .tone-ivory { background: var(--ivory); }
  .tone-white { background: var(--paper); }
  .tone-anthracite { background: var(--anthracite); color: var(--ivory-on-dark); }
  .tone-ocean { background: var(--ocean); color: var(--ivory-on-dark); }
  .ph-grid { align-items: end; row-gap: 2.5rem; }
  .ph-text { grid-column: 1 / span 8; }
  .has-image .ph-text { grid-column: 1 / span 7; align-self: center; }
  .ph-title { margin-top: 1rem; font-size: var(--step-display); line-height: 1.04; max-width: 18ch; }
  .ph-lead { margin-top: 1.5rem; }
  .on-dark .ph-lead { color: var(--ivory-on-dark); }
  .ph-updated { margin-top: 1rem; }
  .ph-slot:empty { display: none; }
  .ph-slot { margin-top: 2rem; }
  .ph-figure { grid-column: 9 / span 4; }
  .ph-figure.is-arch { grid-column: 8 / span 5; }
  .ph-img { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--ivory-2); }
  .ph-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 767px) {
    .ph-img { aspect-ratio: 5 / 4; }
    .is-arch .ph-img { aspect-ratio: 4 / 5; max-width: 420px; }
  }
</style>
