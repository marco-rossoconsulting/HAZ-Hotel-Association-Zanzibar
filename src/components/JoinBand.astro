---
import Icon from './Icon.astro';
interface Props { title?: string; text?: string }
const {
  title = 'Join the hotels that are shaping Zanzibar’s next decade.',
  text = 'Membership pays back: in business won together, in knowledge, in influence and in standing.',
} = Astro.props;
---

<section class="join-band on-dark" aria-labelledby="join-band-title">
  <div class="container grid-12 jb-grid">
    <div class="jb-text">
      <span class="accent-rule" data-rule aria-hidden="true"></span>
      <h2 class="h2 jb-title" id="join-band-title" data-reveal>{title}</h2>
      <p class="jb-sub" data-reveal style="--i:1">{text}</p>
    </div>
    <div class="jb-actions" data-reveal style="--i:2">
      <a class="btn" href="/join/">Join HAZ <Icon name="arrow-right" class="icon-arrow" /></a>
      <a class="btn btn-secondary" href="/affiliates/">For suppliers and partners</a>
    </div>
  </div>
</section>

<style>
  .join-band { background: var(--anthracite); padding-block: clamp(4rem, 3rem + 4vw, 7rem); position: relative; overflow: hidden; }
  .jb-grid { align-items: end; row-gap: 2rem; position: relative; z-index: 1; }
  .jb-text { grid-column: 1 / span 8; }
  .jb-title { margin-top: 1.25rem; max-width: 20ch; color: var(--ivory-on-dark); }
  .jb-sub { margin-top: 1rem; color: var(--muted-on-dark); max-width: 52ch; font-size: var(--step-lead); }
  .jb-actions { grid-column: 9 / span 4; display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: flex-end; }
  @media (max-width: 1023px) { .jb-text { grid-column: 1 / -1; } .jb-actions { grid-column: 1 / -1; justify-content: flex-start; } }
</style>
