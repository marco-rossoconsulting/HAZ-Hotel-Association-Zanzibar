---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { getPhoto } from '@/lib/site';
const photo = await getPhoto('coast');
---

<section class="aff-split bg-ivory" aria-labelledby="aff-title">
  <div class="as-grid">
    <div class="as-img">
      <Image src={photo.image} alt={photo.alt} widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" />
    </div>
    <div class="as-text">
      <p class="label">Affiliate Members</p>
      <h2 class="h2 as-title" id="aff-title" data-reveal>Be the supplier Zanzibar's hotels choose.</h2>
      <p class="as-p" data-reveal style="--i:1">
        Join a selected network of suppliers, professional advisers and service providers working with the island's hotels towards shared goals.
        Membership gives you credibility, visibility and direct access to the people who make hotel decisions.
      </p>
      <ul role="list" class="as-points" data-reveal style="--i:2">
        <li><Icon name="check" /> A listing in the Affiliate Marketplace</li>
        <li><Icon name="check" /> Forums, events and supplier introductions</li>
        <li><Icon name="check" /> Five levels, from Standard to Principal Affiliate</li>
      </ul>
      <a class="btn btn-secondary" href="/affiliates/" data-reveal style="--i:3">Affiliate membership <Icon name="arrow-right" class="icon-arrow" /></a>
    </div>
  </div>
</section>

<style>
  .as-grid { display: grid; grid-template-columns: 1fr 1fr; min-height: 560px; }
  .as-img { position: relative; overflow: hidden; background: var(--ivory-2); }
  .as-img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }
  .as-text { padding: clamp(3rem, 2rem + 4vw, 6rem) var(--margin); max-width: 640px; align-self: center; }
  .as-title { margin-top: 0.75rem; max-width: 16ch; }
  .as-p { margin-top: 1.1rem; max-width: 52ch; }
  .as-points { list-style: none; padding: 0; margin: 1.5rem 0 2rem; display: grid; gap: 0.6rem; }
  .as-points li { display: flex; gap: 0.6rem; align-items: center; font-weight: 500; }
  .as-points .icon { color: var(--gold-deep); }
  @media (max-width: 899px) {
    .as-grid { grid-template-columns: minmax(0, 1fr); }
    .as-img { aspect-ratio: 4 / 3; }
  }
</style>
