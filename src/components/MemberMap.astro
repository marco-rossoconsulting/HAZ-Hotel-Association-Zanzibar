---
/**
 * Interactive map of member hotels by region (Unguja and Pemba).
 * Island outlines: Natural Earth 1:10m (public domain), generated by scripts/gen-map.mjs.
 * Markers sit at region anchors, not at individual hotels: no hotel's exact position is implied.
 */
import map from '@/data/zanzibar-map.json';
import Icon from './Icon.astro';
import { REGIONS } from '@/content.config';

type Member = { id: string; name: string; area?: string; region: (typeof REGIONS)[number]; website?: string };
interface Props {
  members: Member[];
  /** Compact mode (homepage) limits the list height and links to the directory */
  compact?: boolean;
  /** Show a search box above the list */
  search?: boolean;
}
const { members, compact = false, search = false } = Astro.props;

const project = (lon: number, lat: number) => {
  const r = Math.PI / 180;
  const [tx, ty] = map.translate;
  const x = tx + map.scale * lon * r;
  const y = ty - map.scale * Math.log(Math.tan(Math.PI / 4 + (lat * r) / 2));
  return { x: (x / map.width) * 100, y: (y / map.height) * 100 };
};

// Region anchors (approximate town centres)
const anchors: Partial<Record<Member['region'], { lon: number; lat: number; place: string; side: 'l' | 'r' }>> = {
  North: { lon: 39.293, lat: -5.75, place: 'Nungwi and Kendwa', side: 'l' },
  'North-East': { lon: 39.382, lat: -5.985, place: 'Matemwe to Pongwe', side: 'r' },
  'Stone Town & West': { lon: 39.192, lat: -6.163, place: 'Stone Town and the west coast', side: 'r' },
  'South-East': { lon: 39.535, lat: -6.262, place: 'Michamvi to Jambiani', side: 'r' },
  Pemba: { lon: 39.76, lat: -5.17, place: 'Pemba', side: 'r' },
};

const sorted = [...members].sort((a, b) => a.name.localeCompare(b.name, 'en-GB'));
const counts = Object.fromEntries(REGIONS.map((r) => [r, members.filter((m) => m.region === r).length]));
const regionsWithMembers = REGIONS.filter((r) => counts[r] > 0);
const markers = regionsWithMembers
  .filter((r) => anchors[r])
  .map((r) => ({ region: r, count: counts[r], ...anchors[r]!, ...project(anchors[r]!.lon, anchors[r]!.lat) }));
const unguja = project(39.33, -6.33);
const pemba = project(39.56, -5.3);
---

<div class:list={['member-map', { compact }]} data-member-map>
  <div class="mm-visual on-dark">
    <div class="mm-canvas">
      <svg viewBox={`0 0 ${map.width} ${map.height}`} role="img" aria-labelledby="mm-svg-title" class="mm-svg">
        <title id="mm-svg-title">Map of Unguja and Pemba showing where HAZ member hotels are</title>
        <path d={map.unguja} class="island" />
        <path d={map.pemba} class="island" />
      </svg>
      <span class="island-name" style={`left:${unguja.x}%;top:${unguja.y}%`} aria-hidden="true">Unguja</span>
      <span class="island-name" style={`left:${pemba.x}%;top:${pemba.y}%`} aria-hidden="true">Pemba</span>
      {markers.map((m) => (
        <button
          type="button"
          class:list={['marker', `side-${m.side}`]}
          style={`left:${m.x}%;top:${m.y}%`}
          data-region={m.region}
          aria-pressed="false"
          aria-label={`${m.region}: ${m.count} member ${m.count === 1 ? 'hotel' : 'hotels'}. Show in list`}
        >
          <span class="dot" aria-hidden="true"><span class="ring"></span>{m.count}</span>
          <span class="m-label" aria-hidden="true">{m.region}</span>
        </button>
      ))}
    </div>
    <p class="mm-note">Markers show regions, not exact hotel locations.</p>
  </div>

  <div class="mm-list">
    {search && (
      <div class="field mm-search">
        <label for="mm-q">Search member hotels</label>
        <div class="mm-search-box">
          <Icon name="magnifying-glass" />
          <input id="mm-q" type="search" placeholder="Hotel name or village" autocomplete="off" data-mm-q />
        </div>
      </div>
    )}
    <div class="mm-filters" role="group" aria-label="Filter member hotels by region">
      <button type="button" class="chip" aria-pressed="true" data-filter="all">All <span>{members.length}</span></button>
      {regionsWithMembers.map((r) => (
        <button type="button" class="chip" aria-pressed="false" data-filter={r}>{r} <span>{counts[r]}</span></button>
      ))}
    </div>
    <p class="sr-only" aria-live="polite" data-mm-live></p>
    <ul role="list" class="mm-items" data-mm-items>
      {sorted.map((m) => (
        <li class="mm-item" data-region={m.region} data-q={`${m.name} ${m.area ?? ''}`.toLowerCase()}>
          <a href={`/members/${m.id}/`} class="mm-link">
            <span class="mm-name">{m.name}</span>
            <span class="mm-area">{[m.area, m.region].filter(Boolean).join(' · ')}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mm-empty" data-mm-empty hidden>No member hotels match your search.</p>
    {compact && (
      <a class="link-arrow mm-more" href="/members/">See every member hotel <Icon name="arrow-right" /></a>
    )}
  </div>
</div>

<style>
  .member-map { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(1.5rem, 1rem + 2vw, 3rem); align-items: start; }
  .mm-visual { background: var(--ocean); padding: clamp(1rem, 0.5rem + 2vw, 2rem); position: relative; }
  .mm-canvas { position: relative; max-width: 460px; margin-inline: auto; }
  .mm-svg { width: 100%; height: auto; }
  .island { fill: #1c425a; stroke: rgba(213, 167, 68, 0.55); stroke-width: 1.2; vector-effect: non-scaling-stroke; }
  .island-name {
    position: absolute; transform: translate(-50%, -50%);
    font-family: var(--font-display); font-style: italic; font-size: clamp(1rem, 0.8rem + 0.6vw, 1.35rem);
    color: rgba(246, 242, 233, 0.55); pointer-events: none; letter-spacing: 0.02em;
  }
  .marker {
    position: absolute; transform: translate(-50%, -50%);
    background: none; border: 0; padding: 0; display: flex; align-items: center; gap: 0.5rem;
    color: var(--ivory-on-dark);
  }
  .marker.side-l { flex-direction: row-reverse; }
  .marker.side-l { transform: translate(calc(-100% + 18px), -50%); }
  .marker.side-r { transform: translate(-18px, -50%); }
  .dot {
    position: relative; width: 36px; height: 36px; border-radius: 50%;
    display: grid; place-items: center; flex: none;
    background: var(--bronze); color: var(--anthracite);
    font-weight: 700; font-size: 0.85rem; font-variant-numeric: tabular-nums;
    box-shadow: 0 0 0 4px rgba(15, 44, 64, 0.85);
    transition: transform 0.35s var(--ease-out), background-color 0.25s;
  }
  .ring {
    position: absolute; inset: -6px; border-radius: 50%; border: 1px solid rgba(213, 167, 68, 0.7);
    opacity: 0; transform: scale(0.8);
  }
  @media (prefers-reduced-motion: no-preference) {
    .marker:hover .dot, .marker[aria-pressed='true'] .dot { transform: scale(1.12); }
    .marker[aria-pressed='true'] .ring { animation: pulse 2.2s var(--ease-out) infinite; }
  }
  @keyframes pulse { 0% { opacity: 0.9; transform: scale(0.9); } 100% { opacity: 0; transform: scale(1.7); } }
  .marker[aria-pressed='true'] .dot { background: #fff; }
  .m-label {
    font-size: 0.8rem; font-weight: 600; letter-spacing: 0.02em; white-space: nowrap;
    background: rgba(15, 44, 64, 0.85); padding: 0.2rem 0.45rem; border-radius: var(--radius);
  }
  .mm-note { margin-top: 0.75rem; font-size: 0.8rem; color: var(--muted-on-dark); text-align: center; }

  .mm-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; }
  .chip {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 40px; padding: 0.4rem 0.85rem;
    border: 1px solid #b9b1a4; border-radius: 999px; background: transparent; color: var(--anthracite);
    font-size: 0.9rem; font-weight: 500; transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .chip span { font-variant-numeric: tabular-nums; color: var(--taupe-deep); font-weight: 600; }
  .chip:hover { border-color: var(--anthracite); }
  .chip[aria-pressed='true'] { background: var(--anthracite); border-color: var(--anthracite); color: #fff; }
  .chip[aria-pressed='true'] span { color: var(--bronze); }

  .mm-items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; align-content: start; }
  .compact .mm-items { max-height: 30rem; overflow: hidden; mask-image: linear-gradient(#000 80%, transparent); }
  .mm-item { border-top: 1px solid var(--rule); }
  .mm-item[hidden] { display: none; }
  .mm-link { display: grid; gap: 0.1rem; padding: 0.75rem 0; text-decoration: none; color: var(--anthracite); }
  .mm-name { font-weight: 600; line-height: 1.3; transition: color 0.2s; }
  .mm-area { font-size: 0.875rem; color: var(--taupe-deep); }
  .mm-link:hover .mm-name { color: var(--gold-deep); }
  @media (prefers-reduced-motion: no-preference) {
    .mm-item.is-entering { animation: item-in 0.45s var(--ease-out) both; animation-delay: calc(var(--n, 0) * 25ms); }
  }
  @keyframes item-in { from { opacity: 0; transform: translateY(8px); } }
  .mm-more { margin-top: 1.5rem; }
  .mm-search { margin-bottom: 1.25rem; }
  .mm-search-box { position: relative; }
  .mm-search-box :global(.icon) { position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--taupe-deep); }
  .mm-search-box input { padding-left: 2.6rem !important; }
  .mm-empty { padding: 1.25rem 0; color: var(--taupe-deep); border-top: 1px solid var(--rule); }

  @media (max-width: 1023px) {
    .member-map { grid-template-columns: minmax(0, 1fr); }
    .mm-canvas { max-width: 380px; }
  }
  @media (max-width: 560px) {
    .mm-items { grid-template-columns: minmax(0, 1fr); }
    .m-label { font-size: 0.72rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-member-map]').forEach((root) => {
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const markers = Array.from(root.querySelectorAll<HTMLButtonElement>('.marker'));
    const items = Array.from(root.querySelectorAll<HTMLElement>('.mm-item'));
    const live = root.querySelector<HTMLElement>('[data-mm-live]');
    const q = root.querySelector<HTMLInputElement>('[data-mm-q]');
    const empty = root.querySelector<HTMLElement>('[data-mm-empty]');
    let current = 'all';

    const apply = (region: string) => {
      current = region;
      const term = (q?.value ?? '').trim().toLowerCase();
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === region)));
      markers.forEach((m) => m.setAttribute('aria-pressed', String(m.dataset.region === region)));
      let n = 0;
      items.forEach((li) => {
        const show = (region === 'all' || li.dataset.region === region) && (!term || li.dataset.q!.includes(term));
        li.hidden = !show;
        li.classList.remove('is-entering');
        if (show) {
          li.style.setProperty('--n', String(n++));
          void li.offsetWidth;
          li.classList.add('is-entering');
        }
      });
      if (empty) empty.hidden = n > 0;
      if (live) live.textContent = `${n} member ${n === 1 ? 'hotel' : 'hotels'} shown${region === 'all' ? '' : ` in ${region}`}.`;
    };

    chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.filter!)));
    q?.addEventListener('input', () => apply(current));
    markers.forEach((m) =>
      m.addEventListener('click', () => {
        const active = m.getAttribute('aria-pressed') === 'true';
        apply(active ? 'all' : m.dataset.region!);
      }),
    );
  });
</script>
